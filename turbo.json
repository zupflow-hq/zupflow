{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": ["CARGO_INCREMENTAL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "ZUPFLOW_CONTRACT_URL",
        "ZUPFLOW_CONTRACT_RESET_COMMAND",
        "ZUPFLOW_CONTRACT_TOKEN_OWNER",
        "ZUPFLOW_CONTRACT_TOKEN_DEVELOPER",
        "ZUPFLOW_CONTRACT_TOKEN_VIEWER",
        "ZUPFLOW_CONTRACT_TOKEN_OUTSIDER",
        "ZUPFLOW_CONTRACT_OPERATIONS",
        "ZUPFLOW_CONTRACT_CHANNEL_APP_SECRETS_COMMAND"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
