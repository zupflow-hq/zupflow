---
// One run's events in order, as your backend reads them: a model turn, a tool
// call, a pause for approval, and the end. Illustrative data.
type Kind = "run" | "model" | "tool" | "approval" | "end";
const events: { seq: number; at: string; type: string; kind: Kind; text: string; paused?: boolean }[] = [
  { seq: 1, at: "0.0s", type: "run.queued", kind: "run", text: "Admitted for agent Planner" },
  { seq: 2, at: "0.1s", type: "run.started", kind: "run", text: "On claude-sonnet-4-5" },
  { seq: 3, at: "1.6s", type: "tool_call.started", kind: "tool", text: "linear_k7m2qd_list_issues" },
  { seq: 4, at: "2.2s", type: "tool_call.completed", kind: "tool", text: "14 issues" },
  {
    seq: 5,
    at: "4.0s",
    type: "approval.requested",
    kind: "approval",
    text: "update_issue · move ENG-212 to next sprint",
    paused: true,
  },
  {
    seq: 6,
    at: "3m 12s",
    type: "approval.resolved",
    kind: "approval",
    text: "Approved by the person, in your product",
    paused: true,
  },
  { seq: 7, at: "3m 12s", type: "tool_call.started", kind: "tool", text: "linear_k7m2qd_update_issue" },
  { seq: 8, at: "3m 13s", type: "tool_call.completed", kind: "tool", text: "ENG-212 moved" },
  { seq: 9, at: "3m 15s", type: "message.assistant", kind: "model", text: "“Three issues are due this week…”" },
  { seq: 10, at: "3m 15s", type: "run.completed", kind: "end", text: "Output saved on the run" },
];
---

<figure class="zf-fig zf-timeline not-content">
  <div class="zf-fig-body">
    <div class="top">
      <span class="zf-mono">run_034HXHH2LZFzvoaSAhfGVD</span>
      <span class="zf-badge ok">completed</span>
    </div>
    <ol>
      {
        events.map((event) => (
          <li class:list={[event.kind, { paused: event.paused }]}>
            <span class="seq zf-mono">{event.seq}</span>
            <span class="dot" />
            <code class="type">{event.type}</code>
            <span class="text">{event.text}</span>
            <span class="at zf-mono">{event.at}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption>
    A run's events, by <code>sequence</code>. The amber stretch is the pause: the run waits for a decision for as
    long as it takes, holding nothing open.
  </figcaption>
</figure>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 1.4rem 1rem 11.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.42rem 0.5rem;
    border-radius: 0.4rem;
  }
  li.paused {
    background: color-mix(in srgb, var(--zf-amber) 12%, transparent);
  }
  li.paused + li.paused {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  li.paused:has(+ li.paused) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  li:not(:last-child) .dot::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.75rem;
    width: 1px;
    height: 1.6rem;
    background: var(--sl-color-gray-5);
  }
  .seq,
  .at {
    color: var(--sl-color-gray-3);
  }
  .seq {
    text-align: right;
  }
  .dot {
    position: relative;
    width: 0.65rem;
    height: 0.65rem;
    margin: auto;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
  }
  .tool .dot {
    background: var(--sl-color-accent);
  }
  .model .dot {
    background: #8b5cf6;
  }
  .approval .dot {
    background: var(--zf-amber);
  }
  .end .dot {
    background: #22c55e;
  }
  .type {
    font-size: 0.78rem;
    color: var(--sl-color-white);
    background: none;
    padding: 0;
  }
  .text {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 45rem) {
    li {
      grid-template-columns: 1rem minmax(0, 1fr) auto;
      row-gap: 0.1rem;
    }
    .seq {
      display: none;
    }
    .dot {
      grid-row: 1 / 3;
      grid-column: 1;
    }
    .type {
      grid-row: 1;
      grid-column: 2;
    }
    .at {
      grid-row: 1;
      grid-column: 3;
    }
    .text {
      grid-row: 2;
      grid-column: 2 / 4;
      white-space: normal;
    }
    li:not(:last-child) .dot::after {
      display: none;
    }
  }
</style>
