---
// A row of numbered steps joined by a line: the shape of a guide at a glance.
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="zf-strip not-content" style={`--zf-strip-count: ${steps.length}`}>
  {
    steps.map((step, i) => (
      <li>
        <span class="dot">{i + 1}</span>
        <strong>{step.title}</strong>
        <span class="text">{step.text}</span>
      </li>
    ))
  }
</ol>

<style>
  .zf-strip {
    list-style: none;
    margin: 1.75rem 0;
    padding: 1.25rem 1.25rem 1.1rem;
    display: grid;
    grid-template-columns: repeat(var(--zf-strip-count), minmax(0, 1fr));
    gap: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background:
      radial-gradient(circle at 1px 1px, var(--sl-color-gray-5) 1px, transparent 0) 0 0 / 22px 22px,
      var(--sl-color-black);
  }
  li {
    position: relative;
    display: grid;
    gap: 0.3rem;
    align-content: start;
    margin: 0;
  }
  li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 0.9rem;
    left: 2.4rem;
    right: -0.6rem;
    height: 1px;
    background: linear-gradient(90deg, var(--sl-color-accent), var(--sl-color-gray-5));
  }
  .dot {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.35rem;
    border-radius: 50%;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
  }
  strong {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }
  .text {
    font-size: var(--sl-text-xs);
    line-height: 1.45;
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 45rem) {
    .zf-strip {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    li {
      grid-template-columns: auto 1fr;
      column-gap: 0.75rem;
    }
    li .dot {
      grid-row: span 2;
      margin: 0;
    }
    li:not(:last-child)::after {
      display: none;
    }
  }
</style>
